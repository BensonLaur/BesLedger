{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "functions": { "api/[operation].ts": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/", "destination": "/api/health" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/device", "destination": "/api/device" },
    { "source": "/token", "destination": "/api/token" },
    { "source": "/refresh", "destination": "/api/refresh" }
  ]
}
